{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    // ES2022 lib for Error `cause` support (type-level only; target stays
    // ES2020 — `cause` is runtime-supported in all evergreen browsers).
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // P2-39 completion: indexed access yields T | undefined (forces explicit
    // narrowing on array/object lookups) and base-class members must be
    // marked `override` — both catch real drift, and the codebase is clean
    // under them (see the narrowing fixes shipped alongside this change).
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["src"]
}
